                                                <avalonedit:TextEditor Grid.Row="1" x:Name="ScriptCodeEditor" TextChanged="ScriptCodeEditor_TextChanged" ShowLineNumbers="True" FontFamily="Cascadia Code" FontSize="11" Background="#0B1018" Foreground="#DCE6F2" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
