<Window x:Class="OnlyShell.App.MainWindow"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnlyShell.App.Controls"
        xmlns:app="clr-namespace:OnlyShell.App"
        Title="OnlyShell" Icon="Assets/OnlyShell.ico" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Window}" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2,0,0,0" Padding="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="{DynamicResource Type.Size.Title}" HorizontalAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HostRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="主机"><Setter Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="TerminalRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="终端"><Setter Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SftpRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="SFTP"><Setter Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SyncRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="同步"><Setter Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ScriptsRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="脚本"><Setter Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SettingsRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="设置"><Setter Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ScriptFolderExpanderStyle" TargetType="Button">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HostListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderThickness="0">
                        <Grid>
                            <Border x:Name="Marker" Width="2" Background="{DynamicResource Brush.Accent.Primary}" HorizontalAlignment="Left" Visibility="Collapsed" />
                            <ContentPresenter Margin="10,6,6,6" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>

        <!-- Compact application chrome -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.StatusBar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="{DynamicResource Brush.Accent.Primary}"><TextBlock Text="&gt;_" Foreground="{DynamicResource Brush.Text.OnAccent}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Body}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="  ONLYSHELL" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Body}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  /  WORKSPACE" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Width="340" Height="{StaticResource Control.InputHeight}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" HorizontalAlignment="Center">
                    <DockPanel Margin="8,0"><TextBlock Text="&gt;_" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Body}" VerticalAlignment="Center"/><TextBox Text="{Binding HostFilter, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource Type.Size.Small}" Padding="{StaticResource Space.Input.Padding}" VerticalContentAlignment="Center"/><TextBlock Text="Ctrl+K" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Status.Success}"/><TextBlock Text="  SYNC / LOCAL" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/><Border Width="1" Height="16" Background="{DynamicResource Brush.Border.Subtle}" Margin="12,0"/><TextBlock Text="◉" FontSize="{DynamicResource Type.Size.Terminal}" VerticalAlignment="Center"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="252" MinWidth="190" MaxWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>

            <!-- Activity rail -->
            <Border Background="{DynamicResource Brush.Surface.StatusBar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Space.Gap.Top.LG}">
                        <Button Style="{StaticResource HostRailButton}" Tag="▤" Content="主机" Command="{Binding SelectSectionCommand}" CommandParameter="主机" />
                        <Button Style="{StaticResource TerminalRailButton}" Tag="&gt;_" Content="终端" Command="{Binding SelectSectionCommand}" CommandParameter="终端" />
                        <Button Style="{StaticResource SftpRailButton}" Tag="□" Content="SFTP" Command="{Binding SelectSectionCommand}" CommandParameter="SFTP" />
                        <Button Style="{StaticResource ScriptsRailButton}" Tag="fx" Content="脚本" Command="{Binding SelectSectionCommand}" CommandParameter="脚本" />
                        <Button Style="{StaticResource SyncRailButton}" Tag="⇄" Content="同步" Command="{Binding SelectSectionCommand}" CommandParameter="同步" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource SettingsRailButton}" Tag="⚙" Content="设置" Command="{Binding SelectSectionCommand}" CommandParameter="设置" />
                </DockPanel>
            </Border>

            <!-- Host explorer -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Disabled}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,10">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="5,0,4,8"><TextBlock Text="// HOSTS" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/><Button Content="[ + ]" Command="{Binding AddHostCommand}" Background="Transparent" Foreground="{DynamicResource Brush.Accent.Primary}" BorderThickness="0" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" HorizontalAlignment="Right" Padding="4,1" /></DockPanel>
                        <TextBox Text="{Binding HostFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、地址、用户或分组搜索" Height="{StaticResource Control.InputHeight}" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="7,4" FontSize="{DynamicResource Type.Size.Small}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <ContentControl DataContext="{Binding SelectedTerminalTab}" Visibility="{Binding IsRemoteMetricsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{StaticResource Space.Gap.Bottom.LG}">
                            <controls:ServerMetricsView />
                        </ContentControl>
                        <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,0,0,7" />
                        <TextBlock Text="// ACCOUNT" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" />
                        <Button Content="{Binding SyncStatus}" Command="{Binding SelectSectionCommand}" CommandParameter="同步" Background="Transparent" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0" FontSize="{DynamicResource Type.Size.Small}" HorizontalContentAlignment="Left" Padding="0,6" />
                        <TextBlock Text="V1.0 不同步 SSH 密码和私钥" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Label}" TextWrapping="Wrap" Margin="{StaticResource Space.Gap.Bottom.XS}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding VisibleHostCatalogNodes}" SelectedItem="{Binding SelectedHostCatalogNode, Mode=TwoWay}" MouseDoubleClick="Hosts_MouseDoubleClick" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="{StaticResource Space.Gap.Top.LG}">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowSurface" Background="Transparent"><ContentPresenter Margin="3,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Brush.Surface.HoverSubtle}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Brush.Surface.SelectionQuiet}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid Height="36" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TreeIndentWidth}"/><ColumnDefinition Width="18"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="1" Content="{Binding ExpandGlyph}" Command="{Binding DataContext.ToggleHostGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderThickness="0" Padding="0"/><Ellipse x:Name="HostDot" Grid.Column="1" Width="5" Height="5" Fill="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/><Path x:Name="GroupGlyph" Grid.Column="2" Width="16" Height="16" Margin="1,0,4,0" Data="M 1,4 L 7,4 L 9,6 L 16,6 L 16,15 L 1,15 Z" Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="1.3" Fill="{DynamicResource Brush.Surface.SelectionQuiet}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="3" Margin="0,0,2,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="{DynamicResource Type.Size.Small}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" Margin="{StaticResource Space.Gap.Top.XXS}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="False"><Setter TargetName="GroupGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="HostDot" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" Width="{StaticResource Control.SplitterGripSize}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE" Background="{DynamicResource Brush.Border.Subtle}" ToolTip="拖动调整主机列表与工作区宽度" />

            <!-- Main workspace -->
            <Grid Grid.Column="3" Margin="16,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="{Binding ActiveSection, StringFormat='WORKSPACE / {0}'}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Label}"/><TextBlock Text="{Binding SectionHeading}" FontSize="{DynamicResource Type.Size.SectionTitle}" FontWeight="SemiBold" Margin="{StaticResource Space.Gap.Top.XS}" /></StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="[ + POWERSHELL ]" Command="{Binding StartLocalShellCommand}" CommandParameter="powershell" Visibility="{Binding IsTerminalWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" Padding="8,6" Margin="{StaticResource Space.Gap.Right.SM}" />
                        <Button Content="[ + CMD ]" Command="{Binding StartLocalShellCommand}" CommandParameter="cmd" Visibility="{Binding IsTerminalWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" Padding="8,6" Margin="0,0,7,0" />
                        <Button Content="{Binding SplitToggleLabel}" Command="{Binding ToggleSplitViewCommand}" Visibility="{Binding IsTerminalWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" Padding="8,6" Margin="0,0,7,0" />
                        <Button Content="[ + 新建主机 ]" Command="{Binding AddHostCommand}" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" FontWeight="SemiBold" Padding="{StaticResource Space.Button.Padding}" BorderThickness="0" />
                    </StackPanel>
                </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,9" Visibility="{Binding IsHostSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,1" Margin="0,0,7,0" Padding="9,6"><StackPanel><TextBlock Text="// SAVED_HOSTS" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}"/><TextBlock Text="{Binding HostCount, StringFormat={}{0:D2}}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Heading}" Margin="{StaticResource Space.Gap.Top.XS}" /></StackPanel></Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,1" Margin="0,0,7,0" Padding="9,6"><StackPanel><TextBlock Text="// OPEN_TERMINALS" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}"/><TextBlock Text="{Binding ActiveSessionCount, StringFormat={}{0:D2}}" Foreground="{DynamicResource Brush.Status.Success}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Heading}" Margin="{StaticResource Space.Gap.Top.XS}" /></StackPanel></Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,1" Padding="9,6"><StackPanel><TextBlock Text="// CONFIG_SYNC" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}"/><TextBlock Text="{Binding SyncStatus}" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Body}" Margin="{StaticResource Space.Gap.Top.MD}" /></StackPanel></Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Border Visibility="{Binding IsFeaturePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Background="{DynamicResource Brush.Surface}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="{Binding ActiveSection, StringFormat='// {0} / NEXT_MILESTONE'}" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FeatureMessage}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="14,10,14,0" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding IsSettingsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Background="{DynamicResource Brush.Surface}" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="// APPEARANCE_AND_TERMINAL" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" />
                                <TextBlock Text="外观与终端设置" FontSize="{DynamicResource Type.Size.Heading}" FontWeight="SemiBold" Margin="0,6,0,4" />
                                <TextBlock Text="外观调整即时生效，并保存在本机。颜色使用经过校验的主题预设，避免单独修改设计 token 导致界面失衡。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Body}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="主题配色" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,9" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AppearanceThemes}" SelectedItem="{Binding AppearanceTheme, Mode=TwoWay}" Margin="0,0,0,9" Padding="{StaticResource Space.Input.Padding}" />
                                    <TextBlock Grid.Row="1" Text="界面字体" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,9" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding UiFontFamilies}" SelectedItem="{Binding UiFontFamily, Mode=TwoWay}" Margin="0,0,0,9" Padding="{StaticResource Space.Input.Padding}" />
                                    <TextBlock Grid.Row="2" Text="界面字号" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,9" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding UiFontSizes}" SelectedItem="{Binding UiFontSize, Mode=TwoWay}" Margin="0,0,0,9" Padding="{StaticResource Space.Input.Padding}" />
                                    <TextBlock Grid.Row="3" Text="终端字体" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,9" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding TerminalFontFamilies}" SelectedItem="{Binding TerminalFontFamily, Mode=TwoWay}" Margin="0,0,0,9" Padding="{StaticResource Space.Input.Padding}" />
                                    <TextBlock Grid.Row="4" Text="终端字号" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,9" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding TerminalFontSizes}" SelectedItem="{Binding TerminalFontSize, Mode=TwoWay}" Margin="0,0,0,9" Padding="{StaticResource Space.Input.Padding}" />
                                    <TextBlock Grid.Row="5" Text="滚屏缓冲行数" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,9" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding TerminalScrollbackOptions}" SelectedItem="{Binding TerminalScrollbackLines, Mode=TwoWay}" Margin="0,0,0,9" Padding="{StaticResource Space.Input.Padding}" />
                                    <TextBlock Grid.Row="6" Text="粘贴多行内容时确认" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding ConfirmMultiLinePaste, Mode=TwoWay}" VerticalAlignment="Center" Content="显示确认提示" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Grid>
                                <Button Content="[ 恢复默认外观 ]" Command="{Binding ResetAppearanceCommand}" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" Padding="10,6" Margin="0,0,0,16" />
                                <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,0,0,14" />
                                <TextBlock Text="// APPLICATION_DIAGNOSTICS" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" />
                                <TextBlock Text="应用日志与诊断" FontSize="{DynamicResource Type.Size.Heading}" FontWeight="SemiBold" Margin="0,6,0,10" />
                                <TextBlock Text="未处理的启动、界面和后台任务异常会记录在本机。导出的诊断包只包含运行环境信息和应用日志，不包含主机数据库、凭据或脚本文件。日志内容仍可能带有主机地址等信息，请检查后再分享。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Body}" TextWrapping="Wrap" MaxWidth="680" />
