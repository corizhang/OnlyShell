                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="OWNER" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBox Text="{Binding SyncOwner, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="29" Padding="7,5" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="REPOSITORY" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBox Text="{Binding SyncRepository, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="29" Padding="7,5" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="BRANCH" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBox Text="{Binding SyncBranch, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="29" Padding="7,5" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" /></StackPanel>
                                        </Grid>
                                        <Border Background="#201D17" BorderBrush="#544326" BorderThickness="1" Padding="9" Margin="0,12,0,12"><TextBlock Text="加密口令只用于本机加密/解密，每台设备必须使用同一个口令。遗忘后无法恢复远端数据。同步前请确认 GitHub App 已启用 Device Flow，并授权 Repository contents 读写权限。" Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" /></Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="[ PULL / REPLACE LOCAL ]" Command="{Binding PullSyncConfigurationCommand}" IsEnabled="{Binding IsSyncBusy, Converter={StaticResource InverseBooleanConverter}}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="10" Padding="11,7" Margin="0,0,8,0" />
                                            <Button Content="[ ENCRYPT + PUSH ]" Command="{Binding PushSyncConfigurationCommand}" IsEnabled="{Binding IsSyncBusy, Converter={StaticResource InverseBooleanConverter}}" Background="{StaticResource AccentBrush}" Foreground="#17151A" BorderThickness="0" FontFamily="Cascadia Code" FontSize="10" Padding="11,7" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
