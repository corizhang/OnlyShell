                                    <Grid KeyboardNavigation.TabNavigation="Local">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{StaticResource CanvasBrush}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSplitView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" HorizontalAlignment="Left"/>
                                            <Button Content="＋" Command="{Binding AddTerminalTabCommand}" ToolTip="新建标签页并选择服务器" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="13" FontWeight="SemiBold" Width="30" Height="27" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel MinWidth="110">
                                        <Button Content="×" Command="{Binding DataContext.CloseTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" DockPanel.Dock="Right" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="5,0" FontSize="13" />
                                        <TextBlock Text="{Binding DisplayName}" FontFamily="Cascadia Code" FontSize="10" VerticalAlignment="Center" Margin="2,0,7,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                    <Grid Background="#050505">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNewTab}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsSplitView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <controls:TerminalPaneView Grid.Row="0" DataContext="{Binding}" />
                                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource LineBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS" ToolTip="拖动调整终端与 SFTP 面板高度"/>
                                        <controls:SftpWorkspaceView Grid.Row="2" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <Grid Background="{StaticResource CanvasBrush}" Visibility="{Binding DataContext.IsSplitView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="2*"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Background="{StaticResource SurfaceBrush}" LastChildFill="False">
                                            <TextBlock Text="// SPLIT_TERMINALS" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center" Margin="8,0,10,0" />
                                            <Button Content="[ EXIT SPLIT ]" Command="{Binding DataContext.ToggleSplitViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Right" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" FontFamily="Cascadia Code" FontSize="8" Padding="8,0" />
                                        </DockPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="180"/></Grid.ColumnDefinitions>
                                            <TabControl Grid.Column="0" ItemsSource="{Binding DataContext.LeftSplitTabs, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.LeftSplitSelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" AllowDrop="True" Tag="left" PreviewDragOver="SplitTab_DragOver" Drop="SplitTab_Drop" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0">
                                                <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="{StaticResource CanvasBrush}" LastChildFill="False"><TabPanel IsItemsHost="True"/><Button Content="＋" Command="{Binding DataContext.AddLeftSplitTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="在左侧分屏新建连接" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="12" Width="27" Height="25" Margin="4,0,0,0"/></DockPanel><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
                                                <TabControl.ItemTemplate><DataTemplate><DockPanel MinWidth="100"><Button Content="×" Command="{Binding DataContext.CloseLeftSplitTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" DockPanel.Dock="Right" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="4,0"/><TextBlock Text="{Binding DisplayName}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center" Margin="2,0,5,0" PreviewMouseMove="SplitTabHeader_PreviewMouseMove"/></DockPanel></DataTemplate></TabControl.ItemTemplate>
                                                <TabControl.ContentTemplate><DataTemplate><Grid><controls:TerminalPaneView DataContext="{Binding}"><controls:TerminalPaneView.Style><Style TargetType="controls:TerminalPaneView"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsNewTab}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:TerminalPaneView.Style></controls:TerminalPaneView><Border Visibility="{Binding IsNewTab, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource CanvasBrush}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="// QUICK_CONNECT / LEFT" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBlock Text="双击服务器，在左侧分屏建立 SSH 会话" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,10"/></StackPanel><TextBlock Grid.Row="1" Text="// SAVED_HOSTS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" Margin="0,0,0,5"/><ListView Grid.Row="2" ItemsSource="{Binding DataContext.Hosts, RelativeSource={RelativeSource AncestorType=Window}}" Tag="{Binding}" MouseDoubleClick="SplitQuickConnectHosts_MouseDoubleClick" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><ListView.View><GridView><GridViewColumn Header="SERVER" Width="220" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="HOST" Width="220" DisplayMemberBinding="{Binding HostName}"/><GridViewColumn Header="USER" Width="100" DisplayMemberBinding="{Binding UserName}"/></GridView></ListView.View></ListView></Grid></Border></Grid></DataTemplate></TabControl.ContentTemplate>
                                            </TabControl>
                                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE" />
                                            <TabControl Grid.Column="2" ItemsSource="{Binding DataContext.RightSplitTabs, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SplitSecondaryTab, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" AllowDrop="True" Tag="right" PreviewDragOver="SplitTab_DragOver" Drop="SplitTab_Drop" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0">
                                                <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="{StaticResource CanvasBrush}" LastChildFill="False"><TabPanel IsItemsHost="True"/><Button Content="＋" Command="{Binding DataContext.AddRightSplitTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="在右侧分屏新建连接" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="12" Width="27" Height="25" Margin="4,0,0,0"/></DockPanel><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
                                                <TabControl.ItemTemplate><DataTemplate><DockPanel MinWidth="100"><Button Content="×" Command="{Binding DataContext.CloseRightSplitTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" DockPanel.Dock="Right" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="4,0"/><TextBlock Text="{Binding DisplayName}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center" Margin="2,0,5,0" PreviewMouseMove="SplitTabHeader_PreviewMouseMove"/></DockPanel></DataTemplate></TabControl.ItemTemplate>
                                                <TabControl.ContentTemplate><DataTemplate><Grid><controls:TerminalPaneView DataContext="{Binding}"><controls:TerminalPaneView.Style><Style TargetType="controls:TerminalPaneView"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsNewTab}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:TerminalPaneView.Style></controls:TerminalPaneView><Border Visibility="{Binding IsNewTab, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource CanvasBrush}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="// QUICK_CONNECT / RIGHT" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBlock Text="双击服务器，在右侧分屏建立 SSH 会话" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,10"/></StackPanel><TextBlock Grid.Row="1" Text="// SAVED_HOSTS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" Margin="0,0,0,5"/><ListView Grid.Row="2" ItemsSource="{Binding DataContext.Hosts, RelativeSource={RelativeSource AncestorType=Window}}" Tag="{Binding}" MouseDoubleClick="SplitQuickConnectHosts_MouseDoubleClick" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><ListView.View><GridView><GridViewColumn Header="SERVER" Width="220" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="HOST" Width="220" DisplayMemberBinding="{Binding HostName}"/><GridViewColumn Header="USER" Width="100" DisplayMemberBinding="{Binding UserName}"/></GridView></ListView.View></ListView></Grid></Border></Grid></DataTemplate></TabControl.ContentTemplate>
                                            </TabControl>
                                        </Grid>
                                        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource LineBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS" ToolTip="拖动调整终端与 SFTP 面板高度" />
                                        <controls:SftpWorkspaceView Grid.Row="3" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <Border Background="{StaticResource CanvasBrush}" Margin="18" Visibility="{Binding IsNewTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="// QUICK_CONNECT" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="10"/>
                                                    <TextBlock Text="选择服务器以打开 SSH 终端" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,5,0,0"/>
                                                    <TextBlock Text="双击服务器连接；也可以在左侧主机列表中双击直连。" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,12"/>
                                                </StackPanel>
                                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                                    <TextBlock Text="// SAVED_HOSTS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/>
                                                <TextBlock Text="// DOUBLE CLICK TO CONNECT" Foreground="{StaticResource SyntaxGreenBrush}" FontFamily="Cascadia Code" FontSize="9" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <ListView Grid.Row="2" ItemsSource="{Binding DataContext.Hosts, RelativeSource={RelativeSource AncestorType=Window}}" MouseDoubleClick="QuickConnectHosts_MouseDoubleClick" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListView.View><GridView>
                                                        <GridViewColumn Header="SERVER" Width="260"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                                        <GridViewColumn Header="HOST" Width="240" DisplayMemberBinding="{Binding HostName}"/>
                                                        <GridViewColumn Header="PORT" Width="70" DisplayMemberBinding="{Binding Port}"/>
                                                        <GridViewColumn Header="USER" Width="130" DisplayMemberBinding="{Binding UserName}"/>
                                                    </GridView></ListView.View>
                                                </ListView>
                                            </Grid>
                                    </Border>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                    <Border Visibility="{Binding IsTerminalEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="// TERMINAL / NO_ACTIVE_SESSION" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="可从主机页连接 SSH，也可在顶部启动本地 PowerShell 或 CMD。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0" /></StackPanel>
                    </Border>
                    <controls:SftpWorkspaceView Visibility="{Binding IsSftpWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#17161B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0"><TextBlock Text="●" Foreground="{StaticResource SyntaxGreenBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusMessage, StringFormat='  {0}'}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="NET10 / WPF" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        </Border>
    </Grid>
</Window>
