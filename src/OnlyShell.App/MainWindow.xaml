                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding ScriptTemplateFields}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,4">
                                                                <StackPanel>
                                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Kind}" Foreground="{StaticResource SyntaxCyanBrush}" FontFamily="Cascadia Code" FontSize="8" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="23" Padding="4,2" Background="#0B1018" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" FontSize="9" ToolTip="参数或环境变量名称"/><Button Grid.Column="2" Content="×" Command="{Binding DataContext.RemoveScriptTemplateFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#E68174" BorderThickness="0" Padding="0"/></Grid>
                                                                    <Grid Margin="32,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DataContext.ScriptInputTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ValueType, UpdateSourceTrigger=PropertyChanged}" Height="23" Background="#0B1018" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" FontSize="8"/><CheckBox Grid.Column="1" Content="必填" IsChecked="{Binding IsRequired}" Foreground="{StaticResource MutedBrush}" FontSize="8" VerticalAlignment="Center" Margin="5,0"/><CheckBox Grid.Column="2" Content="敏感" IsChecked="{Binding IsSensitive}" Foreground="{StaticResource MutedBrush}" FontSize="8" VerticalAlignment="Center"/></Grid>
                                                                    <Grid Margin="32,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="DEFAULT" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Height" Value="22"/><Setter Property="Padding" Value="4,2"/><Setter Property="Background" Value="#0B1018"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="FontSize" Value="8"/><Setter Property="ToolTip" Value="加密保存的默认值"/><Style.Triggers><DataTrigger Binding="{Binding IsSensitive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><PasswordBox Grid.Column="1" Loaded="TemplateSecretDefaultBox_Loaded" PasswordChanged="TemplateSecretDefaultBox_PasswordChanged"><PasswordBox.Style><Style TargetType="PasswordBox"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Height" Value="22"/><Setter Property="Padding" Value="4,2"/><Setter Property="Background" Value="#0B1018"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="FontSize" Value="8"/><Style.Triggers><DataTrigger Binding="{Binding IsSensitive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></PasswordBox.Style></PasswordBox></Grid>
                                                                    <Grid Margin="32,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="OPTIONS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="4,2" Background="#0B1018" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" FontSize="8" ToolTip="选项类型使用逗号分隔，例如 dev,staging,prod"/></Grid>
                                                                    <Grid Margin="32,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="GROUP" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="4,2" Background="#0B1018" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" FontSize="8" ToolTip="可选分组名；运行窗口按同名连续分组显示"/></Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <TextBlock Grid.Row="2" Text="上次运行值会加密记忆并作为预填默认值。" Foreground="{StaticResource MutedBrush}" FontSize="8" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS" Background="{StaticResource LineBrush}" ToolTip="拖动调整脚本与输出区域高度" />
                                    <Grid Grid.Row="5">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
