                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="[ SAVE ]" Command="{Binding SaveScriptCommand}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="9,6" Margin="0,0,6,0"/><Button Content="[ RUN SCRIPT ]" Command="{Binding RunScriptCommand}" IsEnabled="{Binding IsScriptRunning, Converter={StaticResource InverseBooleanConverter}}" Background="{StaticResource AccentBrush}" Foreground="#17151A" BorderThickness="0" FontFamily="Cascadia Code" FontSize="9" Padding="10,6" Margin="0,0,6,0"/><Button Content="[ RUN ON MULTIPLE ]" Command="{Binding RunScriptOnMultipleHostsCommand}" IsEnabled="{Binding IsScriptRunning, Converter={StaticResource InverseBooleanConverter}}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="9,6" Margin="0,0,6,0"/><Button Content="[ CANCEL ]" Command="{Binding CancelScriptRunCommand}" IsEnabled="{Binding IsScriptRunning}" Background="Transparent" Foreground="#E68174" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="9,6"/></StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="3" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="280"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.2*" MinWidth="220"/></Grid.ColumnDefinitions>
