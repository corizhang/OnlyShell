<Window x:Class="OnlyShell.App.MainWindow"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnlyShell.App.Controls"
        Title="OnlyShell" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2,0,0,0" Padding="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="16" HorizontalAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HostRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="主机"><Setter Property="Background" Value="#29251D"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="TerminalRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="终端"><Setter Property="Background" Value="#29251D"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SftpRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="SFTP"><Setter Property="Background" Value="#29251D"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SyncRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="同步"><Setter Property="Background" Value="#29251D"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ScriptsRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="脚本"><Setter Property="Background" Value="#29251D"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SettingsRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="设置"><Setter Property="Background" Value="#29251D"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ScriptFolderExpanderStyle" TargetType="Button">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HostListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderThickness="0">
                        <Grid>
                            <Border x:Name="Marker" Width="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                            <ContentPresenter Margin="10,6,6,6" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#29251D"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#242229"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>

        <!-- Compact application chrome -->
        <Border Grid.Row="0" Background="#17161B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="{StaticResource AccentBrush}"><TextBlock Text="&gt;_" Foreground="#17151A" FontFamily="Cascadia Code" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="  ONLYSHELL" FontFamily="Cascadia Code" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  /  WORKSPACE" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Width="340" Height="27" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <DockPanel Margin="8,0"><TextBlock Text="&gt;_" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="11" VerticalAlignment="Center"/><TextBox Text="{Binding HostFilter, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="10" Padding="6,4" VerticalContentAlignment="Center"/><TextBlock Text="Ctrl+K" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource SyntaxGreenBrush}"/><TextBlock Text="  SYNC / LOCAL" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/><Border Width="1" Height="16" Background="{StaticResource LineBrush}" Margin="12,0"/><TextBlock Text="◉" FontSize="14" VerticalAlignment="Center"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="252" MinWidth="190" MaxWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>

            <!-- Activity rail -->
            <Border Background="#17161B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Button Style="{StaticResource HostRailButton}" Tag="▤" Content="主机" Command="{Binding SelectSectionCommand}" CommandParameter="主机" />
                        <Button Style="{StaticResource TerminalRailButton}" Tag="&gt;_" Content="终端" Command="{Binding SelectSectionCommand}" CommandParameter="终端" />
                        <Button Style="{StaticResource SftpRailButton}" Tag="□" Content="SFTP" Command="{Binding SelectSectionCommand}" CommandParameter="SFTP" />
                        <Button Style="{StaticResource ScriptsRailButton}" Tag="fx" Content="脚本" Command="{Binding SelectSectionCommand}" CommandParameter="脚本" />
                        <Button Style="{StaticResource SyncRailButton}" Tag="⇄" Content="同步" Command="{Binding SelectSectionCommand}" CommandParameter="同步" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource SettingsRailButton}" Tag="⚙" Content="设置" Command="{Binding SelectSectionCommand}" CommandParameter="设置" />
                </DockPanel>
            </Border>

            <!-- Host explorer -->
            <Border Grid.Column="1" Background="#19181D" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,10">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="5,0,4,8"><TextBlock Text="// HOSTS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/><Button Content="[ + ]" Command="{Binding AddHostCommand}" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderThickness="0" FontFamily="Cascadia Code" FontSize="10" HorizontalAlignment="Right" Padding="4,1" /></DockPanel>
                        <TextBox Text="{Binding HostFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、地址、用户或分组搜索" Height="27" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="7,4" FontSize="10" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <ContentControl DataContext="{Binding SelectedTerminalTab}" Visibility="{Binding IsRemoteMetricsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                            <controls:ServerMetricsView />
                        </ContentControl>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="// ACCOUNT" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" />
                        <Button Content="{Binding SyncStatus}" Command="{Binding SelectSectionCommand}" CommandParameter="同步" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" FontSize="10" HorizontalContentAlignment="Left" Padding="0,6" />
                        <TextBlock Text="V1.0 不同步 SSH 密码和私钥" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding HostsView}" SelectedItem="{Binding SelectedHost, Mode=TwoWay}" MouseDoubleClick="Hosts_MouseDoubleClick" ItemContainerStyle="{StaticResource HostListItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name, StringFormat='// {0}'}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" Margin="7,9,0,4" /></DataTemplate></GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="5" Height="5" Fill="#77727E" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                        <TextBlock Text="{Binding HostName}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE" Background="{StaticResource LineBrush}" ToolTip="拖动调整主机列表与工作区宽度" />

            <!-- Main workspace -->
            <Grid Grid.Column="3" Margin="16,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel><TextBlock Text="{Binding ActiveSection, StringFormat='WORKSPACE / {0}'}" FontFamily="Cascadia Code" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding SectionHeading}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="[ + POWERSHELL ]" Command="{Binding StartLocalShellCommand}" CommandParameter="powershell" Visibility="{Binding IsTerminalWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="8,6" Margin="0,0,5,0" />
                        <Button Content="[ + CMD ]" Command="{Binding StartLocalShellCommand}" CommandParameter="cmd" Visibility="{Binding IsTerminalWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="8,6" Margin="0,0,7,0" />
                        <Button Content="{Binding SplitToggleLabel}" Command="{Binding ToggleSplitViewCommand}" Visibility="{Binding IsTerminalWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="8,6" Margin="0,0,7,0" />
                        <Button Content="[ + 新建主机 ]" Command="{Binding AddHostCommand}" Background="{StaticResource AccentBrush}" Foreground="#17151A" FontFamily="Cascadia Code" FontSize="10" FontWeight="SemiBold" Padding="10,6" BorderThickness="0" />
                    </StackPanel>
                </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,9">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Margin="0,0,7,0" Padding="9,6"><StackPanel><TextBlock Text="// SAVED_HOSTS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBlock Text="{Binding HostCount, StringFormat={}{0:D2}}" FontFamily="Cascadia Code" FontSize="18" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Margin="0,0,7,0" Padding="9,6"><StackPanel><TextBlock Text="// OPEN_TERMINALS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBlock Text="{Binding ActiveSessionCount, StringFormat={}{0:D2}}" Foreground="{StaticResource SyntaxGreenBrush}" FontFamily="Cascadia Code" FontSize="18" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="9,6"><StackPanel><TextBlock Text="// CONFIG_SYNC" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBlock Text="{Binding SyncStatus}" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Border Visibility="{Binding IsFeaturePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="{Binding ActiveSection, StringFormat='// {0} / NEXT_MILESTONE'}" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FeatureMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="14,10,14,0" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding IsSettingsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" Padding="18">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="// APPLICATION_DIAGNOSTICS" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="10" />
                            <TextBlock Text="应用日志与诊断" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,10" />
                            <TextBlock Text="未处理的启动、界面和后台任务异常会记录在本机。导出的诊断包只包含运行环境信息和应用日志，不包含主机数据库、凭据或脚本文件。日志内容仍可能带有主机地址等信息，请检查后再分享。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="680" />
                            <TextBlock x:Name="DiagnosticLogPathText" Foreground="{StaticResource SyntaxCyanBrush}" FontFamily="Cascadia Code" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,12" />
                            <Button Content="[ EXPORT DIAGNOSTICS ]" Click="ExportDiagnostics_Click" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="#17151A" BorderThickness="0" FontFamily="Cascadia Code" FontSize="9" Padding="10,7" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding IsScriptCenterWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="// SCRIPT_CATALOG / LOCAL_ONLY" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="[ + NEW ]" Command="{Binding NewScriptCommand}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="8,5" Margin="0,0,5,0"/>
                                    <Button Content="[ DELETE ]" Command="{Binding DeleteScriptCommand}" Background="Transparent" Foreground="#E68174" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="8,5"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="LOCAL: PowerShell / CMD / Python 3 · REMOTE: Bash / Python 3 · 脚本与输出记录保存在本机" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="{Binding ScriptCatalogPanelHeight}"/><RowDefinition Height="{Binding RecentRunsPanelHeight}"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="{Binding ScriptCatalogListHeight}"/></Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,5"><TextBlock Text="// SCRIPTS" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{Binding ScriptCatalogToggleLabel}" Command="{Binding ToggleScriptCatalogCommand}" Background="Transparent" Foreground="{StaticResource SyntaxCyanBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="5,2"/></DockPanel>
                                    <TextBox Grid.Row="1" Text="{Binding ScriptSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按脚本名称、说明、运行时或目录搜索" Height="25" Margin="0,0,0,5" Padding="5,3" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" FontSize="9" Visibility="{Binding IsScriptCatalogExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ListBox Grid.Row="2" ItemsSource="{Binding VisibleScriptCatalogNodes}" SelectedItem="{Binding SelectedScriptCatalogNode, Mode=TwoWay}" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="3" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="{Binding IsScriptCatalogExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Template"><Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
                                                            <ContentPresenter Margin="3,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#1C1A20"/></Trigger>
                                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#29251D"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="32" ClipToBounds="True">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TreeIndentWidth}"/><ColumnDefinition Width="18"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="1" Content="{Binding ExpandGlyph}" Command="{Binding DataContext.ToggleScriptFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="0" FontFamily="Cascadia Code" FontSize="10" VerticalAlignment="Center" FocusVisualStyle="{x:Null}" Style="{StaticResource ScriptFolderExpanderStyle}" Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Border Grid.Column="1" Visibility="{Binding IsFolder, Converter={StaticResource InverseBooleanConverter}}"/>
                                                    <Grid Grid.Column="2" Width="16" Height="16" Margin="1,0,4,0" VerticalAlignment="Center">
                                                        <Path x:Name="FolderIcon" Data="M 1,4 L 7,4 L 9,6 L 16,6 L 16,15 L 1,15 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" Fill="#29251D"/>
                                                        <Path x:Name="ScriptIcon" Data="M 3,1 L 11,1 L 15,5 L 15,16 L 3,16 Z M 11,1 L 11,5 L 15,5 M 6,9 L 12,9 M 6,12 L 12,12" Stroke="{StaticResource SyntaxCyanBrush}" StrokeThickness="1.1" Fill="Transparent" Visibility="Collapsed"/>
                                                        <Path Data="M 6,14 L 6,15.5 M 8.5,14 L 8.5,15.5 M 11,14 L 11,15.5" Stroke="{StaticResource SyntaxCyanBrush}" StrokeThickness="1" Visibility="Collapsed" x:Name="ScriptIconDetail"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="3" Margin="0,0,2,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="False"><Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="ScriptIcon" Property="Visibility" Value="Visible"/><Setter TargetName="ScriptIconDetail" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,9,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="{Binding RecentRunsListHeight}"/></Grid.RowDefinitions>
