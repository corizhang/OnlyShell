                                            <StackPanel Grid.Column="2"><TextBlock Text="BRANCH" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBox Text="{Binding SyncBranch, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="29" Padding="7,5" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" /></StackPanel>
