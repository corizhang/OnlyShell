                                                    <TextBlock Text="// QUICK_CONNECT" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}"/>
                                                    <TextBlock Text="选择服务器以打开 SSH 终端" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource Type.Size.Title}" Margin="{StaticResource Space.Gap.Top.MD}"/>
                                                    <TextBlock Text="双击服务器连接；也可以在左侧主机列表中双击直连。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Small}" Margin="0,4,0,12"/>
                                                </StackPanel>
                                                <DockPanel Grid.Row="1" Margin="{StaticResource Space.Gap.Bottom.MD}">
                                                    <TextBlock Text="// SAVED_HOSTS" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/>
                                                <TextBlock Text="// DOUBLE CLICK TO CONNECT" Foreground="{DynamicResource Brush.Status.Success}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <ListView Grid.Row="2" ItemsSource="{Binding DataContext.Hosts, RelativeSource={RelativeSource AncestorType=Window}}" MouseDoubleClick="QuickConnectHosts_MouseDoubleClick" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListView.View><GridView>
                                                        <GridViewColumn Header="SERVER" Width="260"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="{DynamicResource Type.Size.Body}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                                        <GridViewColumn Header="HOST" Width="240" DisplayMemberBinding="{Binding HostName}"/>
                                                        <GridViewColumn Header="PORT" Width="70" DisplayMemberBinding="{Binding Port}"/>
                                                        <GridViewColumn Header="USER" Width="130" DisplayMemberBinding="{Binding UserName}"/>
                                                    </GridView></ListView.View>
                                                </ListView>
                                            </Grid>
                                    </Border>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                    <Border Visibility="{Binding IsTerminalEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Background="{DynamicResource Brush.Surface}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="// TERMINAL / NO_ACTIVE_SESSION" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" HorizontalAlignment="Center"/><TextBlock Text="可从主机页连接 SSH，也可在顶部启动本地 PowerShell 或 CMD。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Body}" Margin="0,9,0,0" /></StackPanel>
                    </Border>
                    <controls:SftpWorkspaceView Visibility="{Binding IsSftpWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.StatusBar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0"><TextBlock Text="●" Foreground="{DynamicResource Brush.Status.Success}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusMessage, StringFormat='  {0}'}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/><TextBlock Text="{x:Static app:App.ProductVersion}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        </Border>
    </Grid>
</Window>
