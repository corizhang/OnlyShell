                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DockPanel><TextBlock Text="{Binding SftpHost.HostName, StringFormat='REMOTE  // {0}'}" Foreground="{StaticResource SyntaxCyanBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/><Button Content="[ DISCONNECT ]" Command="{Binding DisconnectSftpCommand}" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Foreground="#E68174" FontFamily="Cascadia Code" /></DockPanel>
                                            <Grid Grid.Row="1" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}" Height="27" VerticalContentAlignment="Center" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" Padding="6,3" FontFamily="Cascadia Code" FontSize="9" />
                                                <Button Grid.Column="1" Content="[ ↑ ]" Command="{Binding NavigateRemoteParentCommand}" Style="{StaticResource FlatButton}" FontFamily="Cascadia Code" Margin="5,0,0,0" />
                                                <Button Grid.Column="2" Content="[ GO ]" Command="{Binding RefreshRemoteDirectoryCommand}" Style="{StaticResource FlatButton}" FontFamily="Cascadia Code" Margin="4,0,0,0" />
                                                <Button Grid.Column="3" Content="[ + DIR ]" Command="{Binding CreateRemoteDirectoryCommand}" Style="{StaticResource FlatButton}" FontFamily="Cascadia Code" Margin="4,0,0,0" />
                                                <Button Grid.Column="4" Content="[ REN ]" Command="{Binding RenameRemoteEntryCommand}" Style="{StaticResource FlatButton}" FontFamily="Cascadia Code" Margin="4,0,0,0" />
                                                <Button Grid.Column="5" Content="[ DEL ]" Command="{Binding DeleteRemoteEntryCommand}" Style="{StaticResource FlatButton}" Foreground="#E68174" FontFamily="Cascadia Code" Margin="4,0,0,0" />
                                            </Grid>
                                        </Grid>
                                        <ListView x:Name="RemoteFileList" Grid.Row="1" ItemsSource="{Binding RemoteFiles}" SelectedItem="{Binding SelectedRemoteFile, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="RemoteFiles_SelectionChanged" MouseDoubleClick="RemoteFiles_MouseDoubleClick" PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" MouseMove="RemoteFiles_MouseMove" AllowDrop="True" DragOver="FilePane_DragOver" Drop="RemoteFiles_Drop" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <ListView.View><GridView>
                                                <GridViewColumn Header="REMOTE FILES" Width="250" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="TYPE" Width="55" DisplayMemberBinding="{Binding TypeLabel}" />
                                                <GridViewColumn Header="SIZE" Width="95" DisplayMemberBinding="{Binding SizeLabel}" />
                                            </GridView></ListView.View>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Visibility="{Binding HasSftpTransfers, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,7,0,0" Padding="5">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding PendingTransferCount, StringFormat='// TRANSFER_QUEUE  ·  {0} QUEUED'}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" Margin="3,2,0,5" />
                                    <ListView ItemsSource="{Binding SftpTransfers}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" MaxHeight="132" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.View><GridView>
                                            <GridViewColumn Header="FILE" Width="170" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="MODE" Width="85" DisplayMemberBinding="{Binding Direction}" />
                                            <GridViewColumn Header="PROGRESS" Width="190"><GridViewColumn.CellTemplate><DataTemplate><DockPanel LastChildFill="False"><ProgressBar Width="135" Height="10" Minimum="0" Maximum="100" Value="{Binding Progress}" VerticalAlignment="Center"/><TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" Margin="7,0,0,0" VerticalAlignment="Center"/></DockPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                            <GridViewColumn Header="STATUS" Width="105"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" ToolTip="{Binding ErrorMessage}" Foreground="{StaticResource SyntaxGreenBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                            <GridViewColumn Header="ACTION" Width="72"><GridViewColumn.CellTemplate><DataTemplate><Button Content="[ CANCEL ]" Command="{Binding DataContext.CancelSftpTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#E68174" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="8" Padding="4,2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                        </GridView></ListView.View>
                                    </ListView>
                                </DockPanel>
                            </Border>
                            <DockPanel Grid.Row="3" Margin="2,5,2,0"><TextBlock Text="SFTP / UTF-8" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9"/><TextBlock Text="{Binding SftpStatus}" Foreground="{StaticResource SyntaxGreenBrush}" FontFamily="Cascadia Code" FontSize="9" HorizontalAlignment="Right" /></DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#17161B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0"><TextBlock Text="●" Foreground="{StaticResource SyntaxGreenBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusMessage, StringFormat='  {0}'}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="NET10 / WPF" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        </Border>
    </Grid>
</Window>
