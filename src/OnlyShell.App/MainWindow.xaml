                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="[ &gt;_ SSH CONNECT ]" Command="{Binding ConnectToSelectedHostCommand}" Style="{StaticResource FlatButton}" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code" Margin="0,0,6,0" />
