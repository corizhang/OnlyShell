<Window x:Class="OnlyShell.App.ScriptInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnlyShell / Script Info" Width="620" MinWidth="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
    <Window.Resources>
        <Style x:Key="ScriptInfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="{DynamicResource Type.Size.Caption}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="// SCRIPT_INFO" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}"/>
            <TextBlock Text="脚本信息" FontSize="{DynamicResource Type.Size.Heading}" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="SCRIPT_NAME" Style="{StaticResource ScriptInfoLabelStyle}"/><TextBox x:Name="NameBox" Height="{StaticResource Control.InputHeight}" Padding="{StaticResource Space.Input.Padding}" Margin="0,4,0,0" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{DynamicResource Type.Size.Small}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="RUNTIME" Style="{StaticResource ScriptInfoLabelStyle}"/><ComboBox x:Name="RuntimeBox" Height="{StaticResource Control.InputHeight}" Margin="0,4,0,0" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{DynamicResource Type.Size.Small}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0"><TextBlock Text="DESCRIPTION" Style="{StaticResource ScriptInfoLabelStyle}"/><TextBox x:Name="DescriptionBox" Height="{StaticResource Control.InputHeight}" Padding="{StaticResource Space.Input.Padding}" Margin="0,4,0,0" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{DynamicResource Type.Size.Small}"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="FOLDER" Style="{StaticResource ScriptInfoLabelStyle}"/><DockPanel Margin="0,4,0,0"><Button DockPanel.Dock="Right" Content="选择…" Click="ChooseFolder_Click" Padding="9,3" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}"/><Border Background="{DynamicResource Brush.Surface.Input}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="7,4"><TextBlock x:Name="FolderPathText" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DockPanel></StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,0,0,12"><TextBlock Text="EXECUTION_TARGET" Style="{StaticResource ScriptInfoLabelStyle}"/><ComboBox x:Name="TargetBox" Height="{StaticResource Control.InputHeight}" Margin="0,4,0,0" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{DynamicResource Type.Size.Small}"/><TextBlock Text="本机支持 PowerShell、CMD、Python 3；远程主机支持 Bash、Python 3。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Caption}" Margin="0,5,0,0"/></StackPanel>
        <DockPanel Grid.Row="4" LastChildFill="False"><TextBlock x:Name="ValidationText" Foreground="{DynamicResource Brush.Status.Error}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" IsCancel="True" MinWidth="72" Padding="10,6" Margin="0,0,8,0" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}"/><Button Content="完成" IsDefault="True" Click="Apply_Click" MinWidth="82" Padding="10,6" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0"/></StackPanel></DockPanel>
    </Grid>
</Window>
