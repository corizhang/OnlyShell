<Window x:Class="OnlyShell.App.HostKeyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH / HOST KEY" Width="{StaticResource Dialog.Width.Connection}" Height="370" MinWidth="{StaticResource Dialog.MinWidth.Connection}" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Window}">
    <Grid Margin="{StaticResource Space.Inset.LG}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="Heading" Text="// SSH / FIRST_CONNECTION" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" Foreground="{DynamicResource Brush.Accent.Primary}"/><TextBlock x:Name="TitleText" Text="核验服务器身份" FontSize="{DynamicResource Type.Size.SectionTitle}" FontWeight="SemiBold" Margin="{StaticResource Space.Gap.Top.MD}"/><TextBlock x:Name="Target" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" Margin="{StaticResource Space.Gap.Top.SM}"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,10">
            <TextBlock Text="请通过可信渠道核对下方 SHA256 指纹。只有确认它属于目标服务器后，才选择信任。" TextWrapping="Wrap" FontSize="{DynamicResource Type.Size.Body}" />
            <TextBlock x:Name="PreviousLabel" Text="之前记录的指纹" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Small}" Margin="0,14,0,4" Visibility="Collapsed" />
            <Border x:Name="PreviousPanel" Background="{DynamicResource Brush.Surface.Error}" BorderBrush="{DynamicResource Brush.Border.Error}" BorderThickness="1" Padding="8" Visibility="Collapsed"><TextBlock x:Name="PreviousFingerprint" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="当前服务器指纹" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Small}" Margin="0,12,0,4" />
            <Border Background="{DynamicResource Brush.Surface.Input}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="9"><TextBlock x:Name="CurrentFingerprint" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Body}" TextWrapping="Wrap" /></Border>
            <TextBlock x:Name="Warning" Text="首次连接会记录此指纹。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Small}" TextWrapping="Wrap" Margin="{StaticResource Space.Gap.Top.XL}" />
        </StackPanel>
        <DockPanel Grid.Row="2"><TextBlock Text="拒绝将中止 SSH 连接。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Label}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="拒绝 [ ESC ]" IsCancel="True" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="{StaticResource Space.Button.Padding}" Margin="{StaticResource Space.Gap.Right.MD}"/><Button x:Name="TrustButton" Content="信任并继续" Click="Trust_Click" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0" Padding="12,6" FontWeight="SemiBold"/></StackPanel></DockPanel>
    </Grid>
</Window>
