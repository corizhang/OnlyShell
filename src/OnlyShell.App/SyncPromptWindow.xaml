<Window x:Class="OnlyShell.App.SyncPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnlyShell / Sync" Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource Brush.Surface.Disabled}" Foreground="{DynamicResource Brush.Text.HighEmphasis}" FontFamily="{DynamicResource Font.Window}">
    <Border BorderBrush="{DynamicResource Brush.Border.Dialog}" BorderThickness="1" Padding="18">
        <StackPanel>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="{DynamicResource Type.Size.BodyLarge}" LineHeight="20" />
            <PasswordBox x:Name="SecretBox" Visibility="Collapsed" Margin="0,14,0,0" Padding="8,6" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.HighEmphasis}" BorderBrush="{DynamicResource Brush.Border.Dialog}" />
            <PasswordBox x:Name="ConfirmBox" Visibility="Collapsed" Margin="{StaticResource Space.Gap.Top.LG}" Padding="8,6" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.HighEmphasis}" BorderBrush="{DynamicResource Brush.Border.Dialog}" />
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource Brush.Status.Error}" FontSize="{DynamicResource Type.Size.Small}" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" MinWidth="76" Padding="10,5" Margin="{StaticResource Space.Gap.Right.LG}" IsCancel="True" />
                <Button x:Name="AcceptButton" Content="已完成" MinWidth="84" Padding="10,5" IsDefault="True" Click="Accept_Click" Background="{DynamicResource Brush.Accent.Hover}" Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
