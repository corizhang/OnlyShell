<Window x:Class="OnlyShell.App.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH / PASSWORD" Width="450" Height="285" MinWidth="420" MinHeight="265"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="AuthHeading" Text="// AUTHENTICATION / PASSWORD" FontFamily="Cascadia Code" FontSize="10" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="PromptTitle" Text="输入 SSH 密码" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="HostText" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Code" FontSize="10" Margin="0,4,0,0"/></StackPanel>
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="32" VerticalAlignment="Top" Background="#111015" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,5" FontSize="12" />
        <CheckBox x:Name="RememberPassword" Grid.Row="3" Content="在此 Windows 用户的凭据管理器中记住密码" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,10,0,0" VerticalAlignment="Top" />
        <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="SecurityNote" Text="仅在 SSH 登录成功后保存；密码不进入配置数据库或同步。" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="[ ESC ] 取消" IsCancel="True" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,6,0"/><Button Content="连接 [ Enter ]" IsDefault="True" Click="Connect_Click" Background="{StaticResource AccentBrush}" Foreground="#17151A" BorderThickness="0" Padding="11,6" FontWeight="SemiBold"/></StackPanel></DockPanel>
    </Grid>
</Window>
