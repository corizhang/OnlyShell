<Window x:Class="OnlyShell.App.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH / PASSWORD" Width="450" Height="310" MinWidth="{StaticResource Dialog.MinWidth.Compact}" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Window}">
    <Grid Margin="{StaticResource Space.Inset.LG}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="AuthHeading" Text="// AUTHENTICATION / PASSWORD" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" Foreground="{DynamicResource Brush.Accent.Primary}"/><TextBlock x:Name="PromptTitle" Text="输入 SSH 密码" FontSize="{DynamicResource Type.Size.Heading}" FontWeight="SemiBold" Margin="{StaticResource Space.Gap.Top.MD}"/><TextBlock x:Name="HostText" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Small}" Margin="{StaticResource Space.Gap.Top.SM}"/></StackPanel>
        <PasswordBox x:Name="PasswordInput" Grid.Row="1" Height="{StaticResource Control.InputHeight.Regular}" Margin="0,14,0,0" VerticalAlignment="Top" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="8,5" FontSize="{DynamicResource Type.Size.BodyLarge}" />
        <CheckBox x:Name="RememberPassword" Grid.Row="2" Content="在此 Windows 用户的凭据管理器中记住密码" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Small}" Margin="0,10,0,0" VerticalAlignment="Top" />
        <TextBlock x:Name="SecurityNote" Grid.Row="3" Text="仅在 SSH 登录成功后保存；密码不进入配置数据库或同步。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Label}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="[ ESC ] 取消" IsCancel="True" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="{StaticResource Space.Button.Padding}" Margin="0,0,8,0"/><Button Content="连接 [ Enter ]" IsDefault="True" Click="Connect_Click" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0" Padding="11,6" FontWeight="SemiBold"/></StackPanel>
    </Grid>
</Window>
