<Window x:Class="OnlyShell.App.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH / PASSWORD" Width="450" Height="285" MinWidth="{StaticResource Dialog.MinWidth.Compact}" MinHeight="265"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Canvas}" Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Window}">
    <Grid Margin="{StaticResource Space.Inset.LG}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="AuthHeading" Text="// AUTHENTICATION / PASSWORD" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Small}" Foreground="{StaticResource Brush.Accent.Primary}"/><TextBlock x:Name="PromptTitle" Text="输入 SSH 密码" FontSize="{StaticResource Type.Size.Heading}" FontWeight="SemiBold" Margin="{StaticResource Space.Gap.Top.MD}"/><TextBlock x:Name="HostText" Foreground="{StaticResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Small}" Margin="{StaticResource Space.Gap.Top.SM}"/></StackPanel>
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="{StaticResource Control.InputHeight.Regular}" VerticalAlignment="Top" Background="{StaticResource Brush.Surface.Input}" Foreground="{StaticResource Brush.Text.Primary}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" Padding="8,5" FontSize="{StaticResource Type.Size.BodyLarge}" />
        <CheckBox x:Name="RememberPassword" Grid.Row="3" Content="在此 Windows 用户的凭据管理器中记住密码" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Type.Size.Small}" Margin="{StaticResource Space.Gap.Top.XL}" VerticalAlignment="Top" />
        <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="SecurityNote" Text="仅在 SSH 登录成功后保存；密码不进入配置数据库或同步。" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Type.Size.Label}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="[ ESC ] 取消" IsCancel="True" Background="Transparent" Foreground="{StaticResource Brush.Text.Secondary}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" Padding="{StaticResource Space.Button.Padding}" Margin="{StaticResource Space.Gap.Right.MD}"/><Button Content="连接 [ Enter ]" IsDefault="True" Click="Connect_Click" Background="{StaticResource Brush.Accent.Primary}" Foreground="{StaticResource Brush.Text.OnAccent}" BorderThickness="0" Padding="11,6" FontWeight="SemiBold"/></StackPanel></DockPanel>
    </Grid>
</Window>
