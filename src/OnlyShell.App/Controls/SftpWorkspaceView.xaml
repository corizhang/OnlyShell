<UserControl x:Class="OnlyShell.App.Controls.SftpWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0" MinHeight="0">
    <Grid>
        <Border Visibility="{Binding IsSftpDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Background="{DynamicResource Brush.Surface}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Text="// SFTP / REMOTE_FILES" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Small}" HorizontalAlignment="Center" />
                <TextBlock Text="选择主机并建立 SFTP 连接" FontSize="{StaticResource Type.Size.HeadingSmall}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{StaticResource Space.Gap.Top.XL}" />
                <TextBlock Text="连接会使用 SSH 主机指纹校验；密码可选择保存在本机 Windows 凭据管理器。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Type.Size.Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,7,12,12" />
                <Button Content="[ CONNECT SFTP ]" Command="{Binding ConnectSftpCommand}" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{StaticResource Brush.Text.OnAccent}" BorderThickness="0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Small}" Padding="12,7" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SftpStatus}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" HorizontalAlignment="Center" Margin="{StaticResource Space.Gap.Top.XL}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid Visibility="{Binding IsSftpConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/></Grid.RowDefinitions>
            <Grid Grid.Row="1" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="6">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="{StaticResource Space.Gap.Bottom.MD}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="LOCAL" Foreground="{DynamicResource Brush.Status.Success}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LocalDrives}" SelectedItem="{Binding SelectedLocalDrive, Mode=TwoWay}" SelectionChanged="LocalDrive_SelectionChanged" Height="{StaticResource Control.InputHeight}" Margin="{StaticResource Space.Gap.Right.SM}" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" />
                            <TextBox Grid.Column="2" Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" Height="{StaticResource Control.InputHeight}" VerticalContentAlignment="Center" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="6,3" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" />
                            <Button Grid.Column="3" Content="[ ↑ ]" Command="{Binding NavigateLocalParentCommand}" Style="{DynamicResource FlatButton}" FontFamily="{StaticResource Font.Mono}" Margin="5,0,0,0" />
                            <Button Grid.Column="4" Content="[ GO ]" Command="{Binding RefreshLocalDirectoryCommand}" Style="{DynamicResource FlatButton}" FontFamily="{StaticResource Font.Mono}" Margin="4,0,0,0" />
                        </Grid>
                        <ListView x:Name="LocalFileList" Grid.Row="1" ItemsSource="{Binding LocalFiles}" SelectedItem="{Binding SelectedLocalEntry, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="LocalFiles_SelectionChanged" MouseDoubleClick="LocalFiles_MouseDoubleClick" PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" MouseMove="LocalFiles_MouseMove" AllowDrop="True" DragOver="FilePane_DragOver" Drop="LocalFiles_Drop" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                            <ListView.View><GridView>
                                <GridViewColumn Header="LOCAL FILES" Width="250"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource Font.Emoji}" FontSize="{StaticResource Type.Size.BodyEmphasis}" Width="22" VerticalAlignment="Center" ToolTip="{Binding TypeLabel}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Header="TYPE" Width="55" DisplayMemberBinding="{Binding TypeLabel}" />
                                <GridViewColumn Header="SIZE" Width="95" DisplayMemberBinding="{Binding SizeLabel}" />
                            </GridView></ListView.View>
                        </ListView>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="▶" ToolTip="上传所选本地文件" Command="{Binding UploadFileCommand}" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{StaticResource Brush.Text.OnAccent}" BorderThickness="0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Title}" Width="{StaticResource Control.TransferButtonWidth}" Height="{StaticResource Control.TransferButtonHeight}" Margin="{StaticResource Space.Gap.Bottom.LG}" />
                    <Button Content="◀" ToolTip="下载所选远程文件" Command="{Binding DownloadRemoteFileCommand}" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Title}" Width="{StaticResource Control.TransferButtonWidth}" Height="{StaticResource Control.TransferButtonHeight}" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="6">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="{StaticResource Space.Gap.Bottom.MD}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock Text="{Binding SftpHost.HostName, StringFormat='REMOTE  // {0}'}" Foreground="{DynamicResource Brush.Status.Info}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" VerticalAlignment="Center"/><Button Content="[ DISCONNECT ]" Command="{Binding DisconnectSftpCommand}" DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Foreground="{StaticResource Brush.Status.Error}" FontFamily="{StaticResource Font.Mono}" /></DockPanel>
                            <Grid Grid.Row="1" Margin="{StaticResource Space.Gap.Top.MD}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}" Height="{StaticResource Control.InputHeight}" VerticalContentAlignment="Center" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="6,3" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" />
                                <Button Grid.Column="1" Content="[ ↑ ]" Command="{Binding NavigateRemoteParentCommand}" Style="{DynamicResource FlatButton}" FontFamily="{StaticResource Font.Mono}" Margin="5,0,0,0" />
                                <Button Grid.Column="2" Content="[ GO ]" Command="{Binding RefreshRemoteDirectoryCommand}" Style="{DynamicResource FlatButton}" FontFamily="{StaticResource Font.Mono}" Margin="4,0,0,0" />
                                <Button Grid.Column="3" Content="[ + DIR ]" Command="{Binding CreateRemoteDirectoryCommand}" Style="{DynamicResource FlatButton}" FontFamily="{StaticResource Font.Mono}" Margin="4,0,0,0" />
                                <Button Grid.Column="4" Content="[ REN ]" Command="{Binding RenameRemoteEntryCommand}" Style="{DynamicResource FlatButton}" FontFamily="{StaticResource Font.Mono}" Margin="4,0,0,0" />
                                <Button Grid.Column="5" Content="[ DEL ]" Command="{Binding DeleteRemoteEntryCommand}" Style="{DynamicResource FlatButton}" Foreground="{StaticResource Brush.Status.Error}" FontFamily="{StaticResource Font.Mono}" Margin="4,0,0,0" />
                            </Grid>
                        </Grid>
                        <ListView x:Name="RemoteFileList" Grid.Row="1" ItemsSource="{Binding RemoteFiles}" SelectedItem="{Binding SelectedRemoteFile, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="RemoteFiles_SelectionChanged" MouseDoubleClick="RemoteFiles_MouseDoubleClick" PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" MouseMove="RemoteFiles_MouseMove" AllowDrop="True" DragOver="FilePane_DragOver" Drop="RemoteFiles_Drop" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                            <ListView.View><GridView>
                                <GridViewColumn Header="REMOTE FILES" Width="250"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource Font.Emoji}" FontSize="{StaticResource Type.Size.BodyEmphasis}" Width="22" VerticalAlignment="Center" ToolTip="{Binding TypeLabel}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Header="TYPE" Width="55" DisplayMemberBinding="{Binding TypeLabel}" />
                                <GridViewColumn Header="SIZE" Width="95" DisplayMemberBinding="{Binding SizeLabel}" />
                            </GridView></ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Visibility="{Binding HasSftpTransfers, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Margin="0,7,0,0" Padding="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PendingTransferCount, StringFormat='// TRANSFER_QUEUE  ·  {0} QUEUED'}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" Margin="3,2,0,5" />
                    <ListView ItemsSource="{Binding SftpTransfers}" Background="Transparent" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0" MaxHeight="132" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View><GridView>
                            <GridViewColumn Header="FILE" Width="170" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="MODE" Width="85" DisplayMemberBinding="{Binding Direction}" />
                            <GridViewColumn Header="PROGRESS" Width="190"><GridViewColumn.CellTemplate><DataTemplate><DockPanel LastChildFill="False"><ProgressBar Width="135" Height="10" Minimum="0" Maximum="100" Value="{Binding Progress}" VerticalAlignment="Center"/><TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" Margin="7,0,0,0" VerticalAlignment="Center"/></DockPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="STATUS" Width="105"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" ToolTip="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Success}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="ACTION" Width="100"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                <Button Content="[ RETRY ]" Command="{Binding DataContext.RetrySftpTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Padding="4,2">
                                    <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="FAILED"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="[ CANCEL ]" Command="{Binding DataContext.CancelSftpTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource Brush.Status.Error}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Padding="4,2">
                                    <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="COMPLETE"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="FAILED"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="CANCELLED"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        </GridView></ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            <DockPanel Grid.Row="3" Margin="2,5,2,0"><TextBlock Text="SFTP / UTF-8" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}"/><TextBlock Text="{Binding SftpStatus}" Foreground="{DynamicResource Brush.Status.Success}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" HorizontalAlignment="Right" /></DockPanel>
        </Grid>
    </Grid>
</UserControl>
