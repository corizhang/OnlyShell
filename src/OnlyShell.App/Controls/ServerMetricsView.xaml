<UserControl x:Class="OnlyShell.App.Controls.ServerMetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0">
    <Border Background="#111015" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                <TextBlock Text="// SERVER_MONITOR" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <TextBlock Text="{Binding MetricsStatus}" Foreground="{DynamicResource SyntaxGreenBrush}" FontFamily="Cascadia Code" FontSize="7" DockPanel.Dock="Right" />
            </DockPanel>
            <TextBlock Text="{Binding MetricsHostLabel}" Foreground="{DynamicResource SyntaxCyanBrush}" FontFamily="Cascadia Code" FontSize="8" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetricsHostLabel}" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <TextBlock Grid.Column="1" Text="{Binding CpuMetricText}" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding CpuProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" Background="#29272E" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="MEMORY" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <TextBlock Grid.Column="1" Text="{Binding MemoryMetricText}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding MemoryProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" Background="#29272E" Foreground="{DynamicResource SyntaxCyanBrush}" BorderThickness="0" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="SWAP" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <TextBlock Grid.Column="1" Text="{Binding SwapMetricText}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding SwapProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" Background="#29272E" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="ROOT DISK" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <TextBlock Grid.Column="1" Text="{Binding DiskMetricText}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Code" FontSize="8" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding DiskProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" Background="#29272E" Foreground="{DynamicResource SyntaxGreenBrush}" BorderThickness="0" />
            </Grid>

            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,1,0,6" />
            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LOAD / 1·5·15M" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7"/><TextBlock Grid.Column="1" Text="{Binding LoadMetricText}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Code" FontSize="8"/></Grid>
            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="UPTIME / PROCS" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7"/><TextBlock Grid.Column="1" Text="{Binding UptimeProcessMetricText}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Code" FontSize="8"/></Grid>
            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="NETWORK RX / TX" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7"/><TextBlock Grid.Column="1" Text="{Binding NetworkMetricText}" Foreground="{DynamicResource SyntaxCyanBrush}" FontFamily="Cascadia Code" FontSize="7"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SSH RTT" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7"/><TextBlock Grid.Column="1" Text="{Binding SshRoundTripText}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Code" FontSize="7"/></Grid>
            <TextBlock Text="{Binding MetricsUpdatedText, StringFormat='UPDATED {0}'}" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
