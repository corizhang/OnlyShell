<UserControl x:Class="OnlyShell.App.Controls.AiAssistantPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0" MinHeight="0">
    <Grid Background="{DynamicResource Brush.Surface}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="{DynamicResource Brush.Surface.TerminalToolbar}" LastChildFill="False" MinHeight="42" Margin="0,0,0,10">
            <StackPanel Margin="12,6,0,6">
                <TextBlock Text="// AI_ASSISTANT / DEEPSEEK" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" />
                <TextBlock Text="终端助手" FontSize="{DynamicResource Type.Size.HeadingSmall}" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="×" Click="Close_Click" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderThickness="0" FontSize="20" Width="38" ToolTip="收起 AI 助手" />
            <Button x:Name="ClearConversationButton" DockPanel.Dock="Right" Content="清空" Click="ClearConversation_Click" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderThickness="0" FontSize="{DynamicResource Type.Size.Caption}" Padding="7,0" ToolTip="清除当前内存对话和命令建议" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="10,0,10,10">
            <TextBlock Text="当前上下文" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Type.Size.Caption}" />
            <TextBlock x:Name="TargetText" Text="尚未绑定终端" Foreground="{DynamicResource Brush.Status.Info}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Label}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
        </StackPanel>
        <TextBox x:Name="TaskBox" Grid.Row="2" MinHeight="76" MaxHeight="112" Margin="10,0,10,8" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{DynamicResource Type.Size.Small}" ToolTip="描述目标或提出问题；可以在上次回答后继续追问" />
        <Border x:Name="SelectedTextPanel" Grid.Row="3" Margin="10,0,10,8" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Background="{DynamicResource Brush.Surface.Terminal}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                <DockPanel Margin="7,5" LastChildFill="True">
                    <Button x:Name="AttachRecentOutputButton" DockPanel.Dock="Right" Content="[ 附加最近输出 ]" Click="AttachRecentOutput_Click" IsEnabled="False" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Tiny}" Padding="5,3" Margin="5,0,0,0" />
                    <CheckBox x:Name="AttachContextCheckBox" DockPanel.Dock="Left" Content="附加给 DeepSeek" Checked="AttachContextCheckBox_Changed" Unchecked="AttachContextCheckBox_Changed" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource Type.Size.Caption}" />
                    <TextBlock x:Name="ContextSourceText" Text="未附加终端内容" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Type.Size.Tiny}" Margin="8,0,0,0" />
                </DockPanel>
                <TextBox x:Name="SelectedTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7" Background="Transparent" Foreground="{DynamicResource Brush.Text.Terminal}" BorderThickness="0" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" />
            </Grid>
        </Border>
        <DockPanel Grid.Row="4" Margin="10,0,10,8" LastChildFill="False">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource Type.Size.Caption}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="[ 取消 ]" Click="Cancel_Click" Visibility="Collapsed" Background="Transparent" Foreground="{DynamicResource Brush.Status.Warning}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" Padding="7,5" Margin="0,0,5,0" />
                <Button x:Name="AskButton" Content="[ 询问 ]" Click="Ask_Click" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" Padding="9,5" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="5" Margin="10,0,10,10">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="ConversationBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="9" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{DynamicResource Type.Size.Small}" />
            <Border x:Name="StreamingPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,7,0,0" BorderBrush="{DynamicResource Brush.Border.Focus}" BorderThickness="1" Background="{DynamicResource Brush.Surface.TerminalToolbar}" Padding="7">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="StreamingHeaderText" DockPanel.Dock="Top" Text="// DEEPSEEK_STREAM" Foreground="{DynamicResource Brush.Status.Info}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Tiny}" Margin="0,0,0,5" />
                    <TextBox x:Name="StreamingPreviewBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="150" Padding="5" Background="Transparent" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0" FontSize="{DynamicResource Type.Size.Caption}" />
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="6" Margin="10,0,10,8">
            <TextBlock Text="// COMMAND_PREVIEW · 可编辑后再使用" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Tiny}" Margin="0,0,0,5" />
            <TextBox x:Name="CommandTextBox" MinHeight="46" MaxHeight="72" Padding="7" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="CommandTextBox_TextChanged" Background="{DynamicResource Brush.Surface.Terminal}" Foreground="{DynamicResource Brush.Text.Terminal}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" />
            <TextBlock x:Name="CommandRiskText" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" FontSize="{DynamicResource Type.Size.Tiny}" Margin="0,4,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="7" HorizontalAlignment="Right" Margin="6,0,6,9">
            <Button Content="[ 保存快捷命令 ]" Click="SaveQuickCommand_Click" IsEnabled="False" x:Name="SaveQuickCommandButton" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" Padding="7,5" Margin="3" ToolTip="打开快捷命令编辑器，检查后再保存" />
            <Button Content="[ 复制 ]" Click="CopyCommand_Click" IsEnabled="False" x:Name="CopyCommandButton" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" Padding="7,5" Margin="3" />
            <Button Content="[ 插入 ]" Click="InsertCommand_Click" IsEnabled="False" x:Name="InsertCommandButton" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}" Padding="7,5" Margin="3" ToolTip="插入当前终端输入区，不会自动执行" />
        </WrapPanel>
    </Grid>
</UserControl>
