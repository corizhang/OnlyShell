<Window x:Class="OnlyShell.App.SftpInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SFTP / INPUT" Width="440" Height="210" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Brush.Canvas}" Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Window}">
    <Grid Margin="{StaticResource Space.Inset.LG}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="REMOTE_NAME" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Small}" Foreground="{StaticResource Brush.Accent.Primary}" />
        <TextBox x:Name="ValueInput" Grid.Row="1" Height="31" Margin="0,12,0,0" Background="{StaticResource Brush.Surface.Input}" Foreground="{StaticResource Brush.Text.Primary}" BorderBrush="{StaticResource Brush.Border.Subtle}" Padding="7,5" />
        <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="[ ESC ] 取消" IsCancel="True" Background="Transparent" Foreground="{StaticResource Brush.Text.Secondary}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" Padding="{StaticResource Space.Button.Padding}" Margin="{StaticResource Space.Gap.Right.MD}"/><Button Content="确认 [ Enter ]" IsDefault="True" Click="Confirm_Click" Background="{StaticResource Brush.Accent.Primary}" Foreground="{StaticResource Brush.Text.OnAccent}" BorderThickness="0" Padding="11,6" FontWeight="SemiBold"/></StackPanel></DockPanel>
    </Grid>
</Window>
