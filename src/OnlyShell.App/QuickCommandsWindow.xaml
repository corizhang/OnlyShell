<Window x:Class="OnlyShell.App.QuickCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnlyShell / Quick Commands" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="// QUICK_COMMANDS" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Small}" />
            <TextBlock Text="快捷命令" FontSize="{StaticResource Type.Size.Heading}" FontWeight="SemiBold" Margin="{StaticResource Space.Gap.Top.XS}" />
            <TextBlock Text="命令支持 {{变量名}} 占位符。选中后可在本窗口填写并预览；变量按输入内容替换，不会自动添加 Shell 引号或转义。插入到当前终端后不会自动回车。模板保存在本机，请勿将密码、令牌或私钥写入模板或默认值。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Type.Size.Small}" TextWrapping="Wrap" Margin="{StaticResource Space.Gap.Top.SM}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="210"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBox x:Name="SearchBox" Height="{StaticResource Control.InputHeight}" Padding="{StaticResource Space.Input.Padding}" Margin="{StaticResource Space.Gap.Bottom.MD}" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{StaticResource Type.Size.Small}" ToolTip="搜索名称、分类、命令和说明" TextChanged="SearchBox_TextChanged" />
                    <Button Content="[ + NEW COMMAND ]" Click="NewCommand_Click" HorizontalAlignment="Stretch" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" Padding="8,5" Margin="{StaticResource Space.Gap.Bottom.MD}" />
                </StackPanel>
                <ListBox x:Name="CommandsList" ItemsSource="{Binding}" SelectionChanged="CommandsList_SelectionChanged" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="3" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" Padding="6,5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.Surface.ListHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.Surface.SelectionQuiet}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Type.Size.Small}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" DockPanel.Dock="Right" Margin="6,0,0,0"/></DockPanel><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Type.Size.Label}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Space.Gap.Top.XXS}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE" Background="{DynamicResource Brush.Border.Subtle}" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="{StaticResource Space.Gap.Bottom.LG}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel Margin="{StaticResource Space.Gap.Right.MD}"><TextBlock Text="COMMAND NAME" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}"/><TextBox x:Name="NameBox" Height="{StaticResource Control.InputHeight}" Padding="{StaticResource Space.Input.Padding}" Margin="{StaticResource Space.Gap.Top.XS}" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{StaticResource Type.Size.Small}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CATEGORY" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}"/><TextBox x:Name="CategoryBox" Height="{StaticResource Control.InputHeight}" Padding="{StaticResource Space.Input.Padding}" Margin="{StaticResource Space.Gap.Top.XS}" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{StaticResource Type.Size.Small}" /></StackPanel></Grid>
                <StackPanel Grid.Row="1" Margin="{StaticResource Space.Gap.Bottom.LG}"><TextBlock Text="DESCRIPTION" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}"/><TextBox x:Name="DescriptionBox" Height="{StaticResource Control.InputHeight}" Padding="{StaticResource Space.Input.Padding}" Margin="{StaticResource Space.Gap.Top.XS}" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontSize="{StaticResource Type.Size.Small}" /></StackPanel>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="COMMAND TEMPLATE" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Margin="{StaticResource Space.Gap.Bottom.XS}"/><TextBox x:Name="CommandBox" Grid.Row="1" AcceptsReturn="False" AcceptsTab="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" Background="{StaticResource Brush.Surface.EditorAlt}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Body}" SpellCheck.IsEnabled="False" TextChanged="CommandBox_TextChanged" /><Border Grid.Column="1" Grid.RowSpan="2" Background="Transparent"/><DockPanel Grid.Column="2" Grid.RowSpan="2" LastChildFill="True" Margin="3,0,0,0"><Button DockPanel.Dock="Top" Content="[ + VARIABLE ]" Click="AddVariable_Click" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Padding="{StaticResource Space.Input.Padding}" Margin="{StaticResource Space.Gap.Bottom.XS}"/><DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow" Background="{StaticResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" RowBackground="{StaticResource Brush.Surface.ListRow}" AlternatingRowBackground="{StaticResource Brush.Surface.ListRowAlt}" FontSize="{StaticResource Type.Size.Label}" CellEditEnding="VariablesGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="LABEL" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="DEFAULT" Binding="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridCheckBoxColumn Header="REQ" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="38"/><DataGridCheckBoxColumn Header="SECRET" Binding="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridCheckBoxColumn Header="REMEMBER" Binding="{Binding RememberValue, UpdateSourceTrigger=PropertyChanged}" Width="65"/></DataGrid.Columns></DataGrid><Button DockPanel.Dock="Bottom" Content="[ REMOVE SELECTED VARIABLE ]" Click="RemoveVariable_Click" Background="Transparent" Foreground="{StaticResource Brush.Status.Error}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Padding="{StaticResource Space.Input.Padding}" Margin="{StaticResource Space.Gap.Top.SM}"/></DockPanel></Grid>
                <StackPanel Grid.Row="3" Margin="{StaticResource Space.Gap.Top.LG}"><DockPanel><TextBlock Text="VALUES FOR INSERTION" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" VerticalAlignment="Center"/><TextBlock Text="REMEMBERED VALUES ARE LOCAL; SECRET VALUES ARE NEVER SAVED" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Tiny}" DockPanel.Dock="Right"/></DockPanel><ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Space.Gap.Top.SM}"><WrapPanel x:Name="VariableInputsPanel" /></ScrollViewer><TextBlock Text="PREVIEW" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Margin="0,5,0,2"/><TextBlock x:Name="PreviewText" Background="{StaticResource Brush.Surface.EditorAlt}" Foreground="{DynamicResource Brush.Status.Success}" Padding="6,5" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" /></StackPanel>
                <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Caption}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="{StaticResource Space.Gap.Top.XL}" LastChildFill="False">
            <Button Content="[ DELETE ]" Click="DeleteCommand_Click" Background="Transparent" Foreground="{StaticResource Brush.Status.Error}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" Padding="9,6" Margin="{StaticResource Space.Gap.Right.SM}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="[ SAVE ]" Click="SaveCommand_Click" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" Padding="{StaticResource Space.Button.Padding}" Margin="{StaticResource Space.Gap.Right.SM}" />
                <Button Content="[ INSERT INTO TERMINAL ]" Click="InsertCommand_Click" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{StaticResource Brush.Text.OnAccent}" BorderThickness="0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" FontWeight="SemiBold" Padding="12,6" />
                <Button Content="[ CLOSE ]" Click="Close_Click" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Size.Label}" Padding="{StaticResource Space.Button.Padding}" Margin="5,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
