<Window x:Class="OnlyShell.App.QuickCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnlyShell / Quick Commands" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="// QUICK_COMMANDS" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Code" FontSize="10" />
            <TextBlock Text="快捷命令" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
            <TextBlock Text="命令支持 {{变量名}} 占位符。选中后可在本窗口填写并预览；变量按输入内容替换，不会自动添加 Shell 引号或转义。插入到当前终端后不会自动回车。模板保存在本机，请勿将密码、令牌或私钥写入模板或默认值。" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="210"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBox x:Name="SearchBox" Height="27" Padding="6,4" Margin="0,0,0,6" Background="#111015" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" FontSize="10" ToolTip="搜索名称、分类、命令和说明" TextChanged="SearchBox_TextChanged" />
                    <Button Content="[ + NEW COMMAND ]" Click="NewCommand_Click" HorizontalAlignment="Stretch" Background="Transparent" Foreground="{DynamicResource SyntaxCyanBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="8,5" Margin="0,0,0,6" />
                </StackPanel>
                <ListBox x:Name="CommandsList" ItemsSource="{Binding}" SelectionChanged="CommandsList_SelectionChanged" Background="#111015" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="3" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" Padding="6,5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1E1C23"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#29251D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Code" FontSize="8" DockPanel.Dock="Right" Margin="6,0,0,0"/></DockPanel><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE" Background="{DynamicResource LineBrush}" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="COMMAND NAME" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8"/><TextBox x:Name="NameBox" Height="27" Padding="6,4" Margin="0,3,0,0" Background="#111015" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" FontSize="10" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CATEGORY" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8"/><TextBox x:Name="CategoryBox" Height="27" Padding="6,4" Margin="0,3,0,0" Background="#111015" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" FontSize="10" /></StackPanel></Grid>
                <StackPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="DESCRIPTION" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8"/><TextBox x:Name="DescriptionBox" Height="27" Padding="6,4" Margin="0,3,0,0" Background="#111015" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" FontSize="10" /></StackPanel>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="COMMAND TEMPLATE" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" Margin="0,0,0,4"/><TextBox x:Name="CommandBox" Grid.Row="1" AcceptsReturn="False" AcceptsTab="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" Background="#0B0D12" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" FontFamily="Cascadia Code" FontSize="11" SpellCheck.IsEnabled="False" TextChanged="CommandBox_TextChanged" /><Border Grid.Column="1" Grid.RowSpan="2" Background="Transparent"/><DockPanel Grid.Column="2" Grid.RowSpan="2" LastChildFill="True" Margin="3,0,0,0"><Button DockPanel.Dock="Top" Content="[ + VARIABLE ]" Click="AddVariable_Click" Background="Transparent" Foreground="{DynamicResource SyntaxCyanBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="8" Padding="6,4" Margin="0,0,0,4"/><DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow" Background="#111015" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" RowBackground="#15141A" AlternatingRowBackground="#19181F" FontSize="9" CellEditEnding="VariablesGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="LABEL" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="DEFAULT" Binding="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridCheckBoxColumn Header="REQ" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="38"/><DataGridCheckBoxColumn Header="SECRET" Binding="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridCheckBoxColumn Header="REMEMBER" Binding="{Binding RememberValue, UpdateSourceTrigger=PropertyChanged}" Width="65"/></DataGrid.Columns></DataGrid><Button DockPanel.Dock="Bottom" Content="[ REMOVE SELECTED VARIABLE ]" Click="RemoveVariable_Click" Background="Transparent" Foreground="#E68174" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="8" Padding="6,4" Margin="0,4,0,0"/></DockPanel></Grid>
                <StackPanel Grid.Row="3" Margin="0,8,0,0"><DockPanel><TextBlock Text="VALUES FOR INSERTION" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" VerticalAlignment="Center"/><TextBlock Text="REMEMBERED VALUES ARE LOCAL; SECRET VALUES ARE NEVER SAVED" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="7" DockPanel.Dock="Right"/></DockPanel><ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"><WrapPanel x:Name="VariableInputsPanel" /></ScrollViewer><TextBlock Text="PREVIEW" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" Margin="0,5,0,2"/><TextBlock x:Name="PreviewText" Background="#0B0D12" Foreground="{DynamicResource SyntaxGreenBrush}" Padding="6,5" TextWrapping="Wrap" FontFamily="Cascadia Code" FontSize="9" /></StackPanel>
                <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Code" FontSize="8" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="[ DELETE ]" Click="DeleteCommand_Click" Background="Transparent" Foreground="#E68174" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="9,6" Margin="0,0,5,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="[ SAVE ]" Click="SaveCommand_Click" Background="Transparent" Foreground="{DynamicResource SyntaxCyanBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="10,6" Margin="0,0,5,0" />
                <Button Content="[ INSERT INTO TERMINAL ]" Click="InsertCommand_Click" Background="{DynamicResource AccentBrush}" Foreground="#17151A" BorderThickness="0" FontFamily="Cascadia Code" FontSize="9" FontWeight="SemiBold" Padding="12,6" />
                <Button Content="[ CLOSE ]" Click="Close_Click" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontFamily="Cascadia Code" FontSize="9" Padding="10,6" Margin="5,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
