<Application x:Class="OnlyShell.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OnlyShell.App">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:BooleanNegationConverter x:Key="InverseBooleanConverter" />
            <Color x:Key="CanvasColor">#151419</Color>
            <Color x:Key="SurfaceColor">#1B1A20</Color>
            <Color x:Key="SurfaceRaisedColor">#242229</Color>
            <Color x:Key="LineColor">#343139</Color>
            <Color x:Key="AccentColor">#E7A92F</Color>
            <Color x:Key="SyntaxGreenColor">#63C985</Color>
            <Color x:Key="SyntaxCyanColor">#56C8CF</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SyntaxGreenBrush" Color="{StaticResource SyntaxGreenColor}" />
            <SolidColorBrush x:Key="SyntaxCyanBrush" Color="{StaticResource SyntaxCyanColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="#E5E2E8" />
            <SolidColorBrush x:Key="MutedBrush" Color="#96919D" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
