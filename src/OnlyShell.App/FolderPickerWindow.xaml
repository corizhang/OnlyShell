<Window x:Class="OnlyShell.App.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OnlyShell.App"
        Title="选择文件夹" Width="420" Height="520" MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Font.Window}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="// SELECT_FOLDER" Foreground="{DynamicResource Brush.Accent.Primary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Size.Caption}"/>
            <DockPanel Margin="0,8,0,0">
                <Button Content="[ + CREATE ]" DockPanel.Dock="Right" Click="CreateFolder_Click" Background="Transparent" Foreground="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="9,4"/>
                <TextBox x:Name="NewFolderNameBox" Height="30" Padding="7,4" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" ToolTip="在当前选中的文件夹下创建子文件夹"/>
            </DockPanel>
        </StackPanel>
        <TreeView x:Name="FolderTree" Grid.Row="1" Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" SelectedItemChanged="FolderTree_SelectedItemChanged">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Highlight}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Highlight}"/>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
                <HierarchicalDataTemplate DataType="{x:Type local:FolderPickerNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="3,3">
                        <Path Data="M 1,4 L 7,4 L 9,6 L 16,6 L 16,15 L 1,15 Z" Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="1.3" Fill="{DynamicResource Brush.Surface.SelectionQuiet}" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="SelectedPathText" Text="/ (根目录)" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Margin="8,0,0,0" Padding="12,6" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}"/>
                <Button Content="选择" IsDefault="True" Click="Select_Click" Margin="8,0,0,0" Padding="12,6" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
