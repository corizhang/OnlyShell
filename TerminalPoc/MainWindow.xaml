<Window x:Class="TerminalPoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vt="clr-namespace:VirtualTerminal;assembly=VirtualTerminal.WPF"
        Title="Terminal PoC" Height="720" Width="1100" MinHeight="440" MinWidth="680"
        Background="#0B1220" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111B2E" Padding="14" BorderBrush="#26344D" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" Padding="18,8" Margin="10,0,0,0" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" Padding="14,8" Margin="8,0,0,0" IsEnabled="False" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="SSH TERMINAL POC" Foreground="#B8C7E0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBox x:Name="HostBox" Width="190" ToolTip="Host" Padding="8,6" Margin="0,0,8,0" />
                    <TextBox x:Name="PortBox" Width="64" ToolTip="Port" Text="22" Padding="8,6" Margin="0,0,8,0" />
                    <TextBox x:Name="UsernameBox" Width="140" ToolTip="Username" Padding="8,6" Margin="0,0,8,0" />
                    <PasswordBox x:Name="PasswordBox" Width="160" ToolTip="Password (PoC only)" Padding="8,6" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Margin="14" Background="#05080F" BorderBrush="#26344D" BorderThickness="1" CornerRadius="8">
            <vt:TerminalControl x:Name="Terminal" AllowDirectInput="False" ScrollDownVisible="True"
                                Background="#05080F" Foreground="#D7E0F0" FontFamily="NSimSun" FontSize="14" />
        </Border>
        <DockPanel Grid.Row="2" Margin="16,0,16,12">
            <TextBlock x:Name="StatusText" Text="Not connected" Foreground="#94A3B8" />
            <TextBlock Text="Password is held only in memory and is not saved" Foreground="#64748B" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
